# Copy to .env.prod (or any environment name) and fill in the values.
# Never commit .env.* files — they are gitignored.

# --- OAuth (recommended for Airbyte Cloud / self-hosted with auth) ---
AIRBYTE_URL=http://your-airbyte-host:8001
AIRBYTE_CLIENT_ID=your-client-id
AIRBYTE_CLIENT_SECRET=your-client-secret
AIRBYTE_WORKSPACE_ID=your-workspace-id

# --- Static token (alternative) ---
# AIRBYTE_TOKEN=eyJ...

# --- Basic auth (alternative) ---
# AIRBYTE_USERNAME=airbyte
# AIRBYTE_PASSWORD=password
